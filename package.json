{
  "name": "heiwa-house-admin-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Self-contained admin dashboard for Heiwa House booking management",
  "scripts": {
    "dev": "next dev -p 3006",
    "build": "next build",
    "build:widget:umd": "tsx scripts/build-widget-umd.ts",
    "build:widget:web": "tsx scripts/build-widget-web.js",
    "build:widget:css": "tailwindcss -c tailwind.config.ts -i src/wordpress/widget-tailwind.css -o wordpress-server/wp-content/plugins/heiwa-booking-widget/assets/build/heiwa-widget.tailwind.css --minify",
    "build:widget": "./scripts/build-widget.sh",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:unit": "jest --config jest.unit.config.js",
    "test:unit:watch": "jest --config jest.unit.config.js --watch",
    "test:unit:coverage": "jest --config jest.unit.config.js --coverage",
    "test:all": "npm run test:unit && npm run test",
    "test:coverage": "npm run test:unit:coverage && playwright test --reporter=html",
    "test:visual": "playwright test --update-snapshots",
    "seed": "tsx scripts/seed-supabase.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@stripe/react-stripe-js": "^4.0.0",
    "@stripe/stripe-js": "^7.9.0",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/auth-helpers-react": "^0.5.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/pg": "^8.15.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.525.0",
    "moment": "^2.30.1",
    "next": "^14.2.32",
    "papaparse": "^5.5.3",
    "pg": "^8.16.3",
    "react": "18.3.1",
    "react-big-calendar": "^1.19.4",
    "react-datepicker": "^8.7.0",
    "react-day-picker": "^9.9.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.62.0",
    "react-slick": "^0.31.0",
    "react-toastify": "^11.0.5",
    "recharts": "^3.1.2",
    "slick-carousel": "^1.8.1",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.9",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18.3.12",
    "@types/react-big-calendar": "^1.16.2",
    "@types/react-dom": "^18.3.1",
    "@types/react-slick": "^0.23.13",
    "audit-ci": "^7.1.0",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^30.1.2",
    "c8": "^10.1.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "k6": "^0.0.0",
    "postcss": "^8.4.49",
    "puppeteer": "^24.22.3",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "admin",
    "dashboard",
    "supabase",
    "nextjs",
    "booking",
    "management",
    "supabase-migration"
  ],
  "author": "Heiwa House",
  "license": "MIT"
}
