  "test_execution_guidelines": {
    "execution_order": [
      "auth_access_control",
      "dashboard_overview",
      "booking_management",
      "client_management",
      "room_management",
      "surf_camp_management",
      "assignment_board",
      "calendar_system",
      "analytics_reporting",
      "compliance_system",
      "system_administration",
      "api_endpoint_testing",
      "performance_monitoring",
      "error_handling",
      "responsive_design",
      "console_error_monitoring",
      "security_validation"
    ],
    "parallel_execution": {
      "allowed_suites": ["performance_monitoring", "console_error_monitoring"],
      "restricted_suites": ["auth_access_control", "booking_management", "api_endpoint_testing"]
    },
    "retry_policy": {
      "max_retries": 3,
      "retry_on": ["network_timeout", "element_not_found", "api_failure"],
      "backoff_strategy": "exponential"
    },
    "cleanup_requirements": {
      "test_data_cleanup": true,
      "session_cleanup": true,
      "created_records_removal": true,
      "cache_clearing": true
    }
  },
  "reporting_requirements": {
    "real_time_reporting": {
      "console_errors": "immediate_alert",
      "critical_failures": "immediate_alert",
      "performance_issues": "warning",
      "security_violations": "immediate_alert"
    },
    "final_report_structure": {
      "test_summary": {
        "total_tests": "count",
        "passed_tests": "count",
        "failed_tests": "count",
        "skipped_tests": "count",
        "execution_time": "duration"
      },
      "suite_results": {
        "suite_name": "string",
        "status": "passed|failed|skipped",
        "test_count": "number",
        "duration": "milliseconds",
        "error_details": "array"
      },
      "console_monitoring": {
        "errors": "array",
        "warnings": "array",
        "network_failures": "array",
        "performance_issues": "array"
      },
      "performance_metrics": {
        "page_load_times": "object",
        "api_response_times": "object",
        "memory_usage": "object",
        "error_rates": "object"
      },
      "recommendations": "array"
    },
    "alerting_thresholds": {
      "console_errors": ">0",
      "test_failure_rate": ">5%",
      "page_load_time": ">3000ms",
      "api_response_time": ">1000ms"
    }
