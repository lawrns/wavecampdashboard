{
  "test_metadata": {
    "name": "Comprehensive Admin Section AI Browser Test",
    "description": "A complete automated testing suite for browser-connected AI to thoroughly validate all admin functionality, UI/UX, API endpoints, and console error monitoring",
    "version": "1.0.0",
    "target_environment": "production",
    "estimated_duration": "45-60 minutes",
    "browser_requirements": {
      "chrome": ">=120.0",
      "firefox": ">=115.0",
      "safari": ">=17.0",
      "viewport": {
        "desktop": "1280x720",
        "tablet": "768x1024",
        "mobile": "375x667"
      }
    }
  },
  "authentication_context": {
    "login_credentials": {
      "email": "admin@heiwa.house",
      "password": "admin123456"
    },
    "expected_redirects": {
      "successful_login": "/admin",
      "unauthenticated_access": "/login"
    },
    "session_validation": {
      "check_user_display": "admin@heiwa.house",
      "verify_admin_badge": true,
      "test_session_persistence": true
    }
  },
  "test_suites": [
    {
      "suite_id": "auth_access_control",
      "name": "Authentication & Access Control",
      "description": "Test login, logout, session management, and unauthorized access prevention",
      "priority": "critical",
      "test_cases": [
        {
          "id": "login_successful",
          "description": "Login with valid admin credentials",
          "steps": [
            "Navigate to /login",
            "Fill email and password fields",
            "Click login button",
            "Verify redirect to /admin",
            "Check user display in header"
          ],
          "validations": [
            "URL redirects to /admin",
            "Admin dashboard title visible",
            "User email displayed",
            "No console errors"
          ]
        },
        {
          "id": "unauthorized_admin_access",
          "description": "Attempt to access admin without authentication",
          "steps": [
            "Clear browser session",
            "Navigate directly to /admin",
            "Verify redirect to login"
          ],
          "validations": [
            "Redirected to /login page",
            "No admin content visible",
            "Appropriate error message"
          ]
        },
        {
          "id": "session_persistence",
          "description": "Test session persistence across page refreshes",
          "steps": [
            "Login successfully",
            "Refresh admin dashboard page",
            "Navigate between admin pages",
            "Verify session remains active"
          ],
          "validations": [
            "No logout after refresh",
            "Navigation works without re-auth",
            "User context maintained"
          ]
        },
        {
          "id": "logout_functionality",
          "description": "Test logout and session cleanup",
          "steps": [
            "Click logout/sign out button",
            "Verify redirect to login",
            "Try to access admin after logout",
            "Verify blocked access"
          ],
          "validations": [
            "Redirected to /login",
            "Cannot access admin pages",
            "Session properly cleared"
          ]
        }
      ]
    },
    {
